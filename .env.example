# Anthropic
ANTHROPIC_API_KEY=

# Optional overrides — defaults live in lib/claude/models.ts
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
CHAT_MODEL=claude-opus-5

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose this to the browser / never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Geoapify (myprojects.geoapify.com) — powers the nearby-vets lookup.
# Geoapify issues a separate key per API product, not one unified key.
GEOAPIFY_GEOCODING_API_KEY=
GEOAPIFY_PLACES_API_KEY=
